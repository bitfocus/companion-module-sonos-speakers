{
	"name": "sonos-speakers",
	"version": "2.0.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@svrooij/sonos": "^2.7.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.1",
		"@types/node": "^26",
		"eslint": "^10",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-sonos-speakers.git"
	},
	"packageManager": "yarn@4.18.1"
}
