{
	"name": "sonos-speakers",
	"version": "2.0.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"package": "yarn build && companion-module-build"
	},
	"license": "MIT",
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix"
		]
	},
	"engines": {
		"node": "^26"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@svrooij/sonos": "^2.7.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^26",
		"eslint": "^10",
		"prettier": "^3",
		"rimraf": "^6.1.4",
		"typescript": "^6",
		"typescript-eslint": "^8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-sonos-speakers.git"
	}
}
